ble GPU acceleration\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" translate\u003ETick this if you're experiencing aliasing, ghosting or other visual issues\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Ctoggle [(ngModel)]=\"config.store.hacks.disableGPU\" (ngModelChange)=\"config.save(); config.requestRestart()\"\u003E\u003C\u002Ftoggle\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"form-line\" *ngIf=\"hostApp.platform === Platform.Windows &amp;&amp; isFluentVibrancySupported\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" translate\u003EEnable fluent background option\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" translate\u003EExperimental Windows 10 background style known to cause issues\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Ctoggle [(ngModel)]=\"config.store.hacks.enableFluentBackground\" (ngModelChange)=\"config.save()\"\u003E\u003C\u002Ftoggle\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"form-line\" *ngIf=\"hostApp.platform === Platform.Windows &amp;&amp; isFluentVibrancySupported\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" translate\u003EDisable fluent background while dragging\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" translate\u003EFluent background sometimes causes drag lag\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Ctoggle [(ngModel)]=\"config.store.hacks.disableVibrancyWhileDragging\" (ngModelChange)=\"config.save(); config.requestRestart()\"\u003E\u003C\u002Ftoggle\u003E\n\u003C\u002Fdiv\u003E";;return pug_html;};
