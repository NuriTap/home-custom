pug_html = pug_html + "\n\u003Ch3 class=\"mb-3\" translate\u003EWindow\u003C\u002Fh3\u003E\n\u003Cdiv class=\"form-line\" *ngIf=\"themes.length &gt; 1\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" translate\u003ETheme\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cselect class=\"form-control\" [(ngModel)]=\"config.store.appearance.theme\" (ngModelChange)=\"saveConfiguration()\"\u003E\n    \u003Coption *ngFor=\"let theme of themes\" [ngValue]=\"theme.name\"\u003E{{theme.name|translate}}\u003C\u002Foption\u003E\n  \u003C\u002Fselect\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"form-line\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" translate\u003ESpaciness\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" translate\u003EControls the amount of space between elements\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cinput type=\"range\" [(ngModel)]=\"config.store.appearance.spaciness\" (mouseup)=\"saveConfiguration()\" min=\"0.6\" max=\"1.4\" step=\"0.1\"\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"form-line\" *ngIf=\"hostApp.platform === Platform.Web\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" translate\u003EAsk before closing the browser tab\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" translate\u003EPrevents accidental closing\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Ctoggle [(ngModel)]=\"config.store.web.preventAccidentalTabClosure\" (ngModelChange)=\"saveConfiguration()\"\u003E\u003C\u002Ftoggle\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"form-line\" *ngIf=\"platform.supportsWindowControls\"\u003E\n  \u003Cdiv class=\"header\"\u003E\n    \u003Cdiv class=\"title\" *ngIf=\"hostApp.platform !== Platform.macOS\" translate\u003EAcrylic background\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"title\" *ngIf=\"hostApp.platform === Platform.macOS\" translate\u003EVibrancy\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"description\" tr